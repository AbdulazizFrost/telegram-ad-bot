# ==========================================
# TELEGRAM ANTI-AD MODERATION BOT CONFIG
# ==========================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Main Administrator Telegram ID (numeric)
ADMIN_ID=123456789

# Database URL:
# SQLite (default for local development):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# PostgreSQL (for Render / Production VPS with external database):
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Timezone (Default: Asia/Tashkent)
BOT_TIMEZONE=Asia/Tashkent

# Seconds before temporary warning notification is deleted in the group (default: 10)
NOTICE_DELETE_SECONDS=10

# Days to retain moderation logs before automatic cleanup (default: 90)
MODERATION_LOG_RETENTION_DAYS=90

# Scoring threshold to classify message as advertisement (default: 50)
AD_DETECTION_THRESHOLD=50

# Bank Card Payment Details (can also be changed by admin via /admin panel)
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=ADMINISTRATOR NAME

# Webhook Configuration (Leave blank for local Polling mode)
# On Render Web Service: set to your public Render URL, e.g. https://your-bot.onrender.com
WEBHOOK_URL=
# Listening port on Render (Render automatically injects PORT env variable)
PORT=10000
