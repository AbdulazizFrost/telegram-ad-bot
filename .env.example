# ==========================================
# TELEGRAM ANTI-AD MODERATION BOT CONFIG
# ==========================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Main Administrator Telegram ID (numeric)
ADMIN_ID=123456789

# Database URL:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Timezone (Default: Asia/Tashkent)
BOT_TIMEZONE=Asia/Tashkent

# Seconds before temporary warning notification is deleted in the group (default: 10)
NOTICE_DELETE_SECONDS=10

# Bank Card Payment Details
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=ADMINISTRATOR

# Webhook Configuration (Leave blank for local Polling mode)
WEBHOOK_URL=
PORT=10000

# AI Moderation (Tier 2 Semantic Classifier)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_AD_THRESHOLD=0.90
AI_TIMEOUT=8.0
AI_CACHE_TTL=3600
AI_MAX_CONCURRENT=3
AI_RATE_LIMIT_RPM=12

